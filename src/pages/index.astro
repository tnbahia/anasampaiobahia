---
const googleFormsUrl = '';
const hasGoogleForm = Boolean(googleFormsUrl);
const contactUrl = `${import.meta.env.BASE_URL}#contacto`;
const articlesUrl = `${import.meta.env.BASE_URL}#artigos`;
---

<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ana Sampaio Bahia | Psicóloga</title>
    <meta
      name="description"
      content="Landing page da Ana Sampaio Bahia, psicóloga, com informação profissional, projetos, artigos e contacto."
    />
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem('theme-preference');
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const theme = savedTheme || systemTheme;
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <style>
      :root {
        color-scheme: light dark;
        --background: #f6f1eb;
        --background-rgb: 246, 241, 235;
        --surface: rgba(255, 255, 255, 0.8);
        --surface-strong: rgba(255, 255, 255, 0.92);
        --surface-alt: rgba(245, 231, 219, 0.9);
        --text: #2e2924;
        --muted: #675f58;
        --accent: #9f5f72;
        --accent-strong: #7f4358;
        --accent-soft: rgba(159, 95, 114, 0.12);
        --secondary: #4d7a83;
        --secondary-soft: rgba(77, 122, 131, 0.16);
        --border: rgba(115, 92, 74, 0.15);
        --shadow: 0 24px 80px rgba(51, 39, 28, 0.14);
        --shadow-soft: 0 12px 32px rgba(51, 39, 28, 0.08);
      }

      :root[data-theme='dark'] {
        --background: #11131a;
        --background-rgb: 17, 19, 26;
        --surface: rgba(21, 26, 36, 0.72);
        --surface-strong: rgba(24, 29, 41, 0.9);
        --surface-alt: rgba(38, 47, 64, 0.78);
        --text: #f4ede5;
        --muted: #c8c1ba;
        --accent: #f09ab1;
        --accent-strong: #f7b3c4;
        --accent-soft: rgba(240, 154, 177, 0.14);
        --secondary: #8ed8dc;
        --secondary-soft: rgba(142, 216, 220, 0.14);
        --border: rgba(255, 255, 255, 0.12);
        --shadow: 0 28px 90px rgba(3, 6, 12, 0.45);
        --shadow-soft: 0 12px 36px rgba(3, 6, 12, 0.28);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background:
          radial-gradient(circle at top left, rgba(244, 204, 180, 0.55), transparent 28%),
          radial-gradient(circle at top right, rgba(142, 216, 220, 0.28), transparent 24%),
          linear-gradient(180deg, rgba(var(--background-rgb), 1) 0%, rgba(var(--background-rgb), 0.98) 30%, rgba(var(--background-rgb), 1) 100%);
        overflow-x: hidden;
      }

      body::before,
      body::after {
        content: '';
        position: fixed;
        inset: auto;
        width: 24rem;
        height: 24rem;
        border-radius: 50%;
        pointer-events: none;
        filter: blur(18px);
        opacity: 0.45;
        z-index: 0;
        animation: float 16s ease-in-out infinite;
      }

      body::before {
        top: -6rem;
        right: -6rem;
        background: rgba(159, 95, 114, 0.16);
      }

      body::after {
        bottom: 10rem;
        left: -8rem;
        background: rgba(77, 122, 131, 0.14);
        animation-delay: -8s;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        font: inherit;
      }

      .page {
        position: relative;
        z-index: 1;
        width: min(1160px, calc(100% - 2rem));
        margin: 0 auto;
        padding-bottom: 4rem;
      }

      .shell {
        position: relative;
        overflow: hidden;
        backdrop-filter: blur(20px);
        background: linear-gradient(180deg, var(--surface-strong), var(--surface));
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
      }

      .shell,
      .card,
      .feature,
      .contact,
      .timeline__item,
      .quote,
      .spotlight {
        border-radius: 28px;
      }

      .topbar {
        position: sticky;
        top: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        margin: 1rem 0 1.5rem;
        background: rgba(var(--background-rgb), 0.58);
        border: 1px solid var(--border);
        backdrop-filter: blur(18px);
        box-shadow: var(--shadow-soft);
        border-radius: 999px;
        z-index: 5;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        font-weight: 700;
      }

      .brand__mark {
        display: grid;
        place-items: center;
        width: 2.6rem;
        height: 2.6rem;
        border-radius: 0.95rem;
        background: linear-gradient(135deg, var(--accent), var(--secondary));
        color: #fff;
        box-shadow: 0 12px 26px rgba(159, 95, 114, 0.24);
      }

      .topbar__actions,
      .actions,
      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
      }

      .theme-toggle,
      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        padding: 0.95rem 1.35rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.16);
        color: var(--text);
        transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
      }

      .theme-toggle {
        cursor: pointer;
      }

      .button--primary {
        color: #fff;
        background: linear-gradient(135deg, var(--accent), var(--accent-strong));
        border-color: transparent;
        box-shadow: 0 14px 30px rgba(159, 95, 114, 0.28);
      }

      .button--secondary {
        background: var(--surface);
      }

      .button--disabled {
        opacity: 0.75;
        cursor: not-allowed;
        background: var(--surface-alt);
      }

      .button:hover,
      .theme-toggle:hover,
      .card:hover,
      .feature:hover,
      .spotlight:hover,
      .timeline__item:hover {
        transform: translateY(-4px);
      }

      .button:hover,
      .theme-toggle:hover {
        box-shadow: var(--shadow-soft);
        border-color: rgba(159, 95, 114, 0.3);
      }

      .button:focus-visible,
      .theme-toggle:focus-visible {
        outline: 3px solid var(--accent-strong);
        outline-offset: 3px;
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
        gap: 1.5rem;
        padding: 1.5rem;
      }

      .hero__content,
      .hero__panel {
        padding: clamp(1.6rem, 3vw, 2.6rem);
      }

      .hero__content {
        position: relative;
      }

      .eyebrow,
      .chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        width: fit-content;
        border-radius: 999px;
        font-size: 0.95rem;
      }

      .eyebrow {
        padding: 0.55rem 0.95rem;
        margin-bottom: 1.35rem;
        background: var(--accent-soft);
        color: var(--accent-strong);
        font-weight: 700;
      }

      h1,
      h2,
      h3,
      p,
      ul {
        margin: 0;
      }

      h1 {
        max-width: 10ch;
        font-size: clamp(3.1rem, 8vw, 5.5rem);
        line-height: 0.92;
        letter-spacing: -0.05em;
        margin-bottom: 1rem;
      }

      .lead {
        max-width: 58ch;
        color: var(--muted);
        font-size: 1.12rem;
        line-height: 1.75;
      }

      .hero__copy {
        display: grid;
        gap: 1.5rem;
      }

      .hero__panel {
        display: grid;
        gap: 1rem;
        align-content: space-between;
      }

      .spotlight {
        position: relative;
        overflow: hidden;
        padding: 1.35rem;
        background:
          radial-gradient(circle at top right, rgba(255, 255, 255, 0.24), transparent 28%),
          linear-gradient(160deg, rgba(159, 95, 114, 0.94), rgba(77, 122, 131, 0.95));
        color: #fff;
        min-height: 16rem;
        box-shadow: 0 22px 40px rgba(77, 122, 131, 0.18);
      }

      .spotlight::after {
        content: '';
        position: absolute;
        inset: auto -3rem -3rem auto;
        width: 12rem;
        height: 12rem;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
      }

      .spotlight h2 {
        font-size: 1.25rem;
        margin-bottom: 0.7rem;
      }

      .spotlight p {
        line-height: 1.75;
        max-width: 28ch;
        color: rgba(255, 255, 255, 0.88);
      }

      .panel-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
      }

      .stat {
        padding: 1.15rem;
        background: var(--surface-alt);
        border: 1px solid var(--border);
        border-radius: 22px;
      }

      .stat strong {
        display: block;
        margin-bottom: 0.25rem;
        font-size: 1.7rem;
      }

      .stat span {
        color: var(--muted);
        line-height: 1.5;
        font-size: 0.95rem;
      }

      main {
        display: grid;
        gap: 1.5rem;
        margin-top: 1.5rem;
      }

      section {
        padding: 1.75rem;
      }

      .section-heading {
        display: grid;
        gap: 0.7rem;
        margin-bottom: 1.5rem;
      }

      .section-heading h2 {
        font-size: clamp(1.7rem, 4vw, 2.4rem);
        letter-spacing: -0.04em;
      }

      .section-heading p,
      .card p,
      .card li,
      .feature p,
      .timeline__item p,
      .contact p,
      .quote p {
        color: var(--muted);
        line-height: 1.75;
      }

      .grid,
      .features,
      .timeline {
        display: grid;
        gap: 1rem;
      }

      .grid {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      }

      .features {
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      }

      .timeline {
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      }

      .card,
      .feature,
      .timeline__item,
      .quote,
      .contact {
        padding: 1.5rem;
        background: var(--surface);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-soft);
        transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
      }

      .card h3,
      .feature h3,
      .timeline__item h3 {
        margin-bottom: 0.8rem;
        font-size: 1.1rem;
      }

      .chip {
        padding: 0.45rem 0.8rem;
        background: var(--surface-alt);
        color: var(--accent-strong);
        font-weight: 600;
      }

      .feature {
        position: relative;
        overflow: hidden;
      }

      .feature::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, var(--accent-soft), transparent 55%);
        opacity: 0;
        transition: opacity 220ms ease;
      }

      .feature:hover::before {
        opacity: 1;
      }

      .feature__icon {
        display: grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        margin-bottom: 1rem;
        border-radius: 1rem;
        background: linear-gradient(135deg, var(--accent-soft), var(--secondary-soft));
        font-size: 1.3rem;
      }

      .stack {
        display: grid;
        gap: 0.95rem;
        padding-left: 1.1rem;
      }

      .quote {
        display: grid;
        gap: 1rem;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        background:
          radial-gradient(circle at top left, var(--accent-soft), transparent 28%),
          var(--surface);
      }

      .quote strong {
        font-size: 1rem;
      }

      .contact {
        display: grid;
        gap: 1.25rem;
      }

      .contact__meta {
        display: grid;
        gap: 0.9rem;
      }

      .contact__meta a {
        color: var(--accent-strong);
        font-weight: 700;
      }

      .tab-shell {
        padding: 1.25rem;
      }

      .tab-shell__header {
        display: grid;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }

      .tablist {
        display: flex;
        flex-wrap: nowrap;
        gap: 0.75rem;
        overflow-x: auto;
        padding-bottom: 0.35rem;
        scrollbar-width: thin;
      }

      .tab {
        flex: 0 0 auto;
        padding: 0.85rem 1rem;
        border: 1px solid var(--border);
        border-radius: 1rem;
        background: var(--surface);
        color: var(--muted);
        cursor: pointer;
        transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease, color 180ms ease, box-shadow 180ms ease;
      }

      .tab[aria-selected='true'] {
        color: var(--text);
        background: linear-gradient(135deg, var(--accent-soft), var(--secondary-soft));
        border-color: rgba(159, 95, 114, 0.28);
        box-shadow: var(--shadow-soft);
      }

      .tab:hover {
        transform: translateY(-3px);
        border-color: rgba(159, 95, 114, 0.22);
      }

      .tab:focus-visible {
        outline: 3px solid var(--accent-strong);
        outline-offset: 3px;
      }

      .tab-panels {
        position: relative;
      }

      .tab-panel {
        display: grid;
        gap: 1.25rem;
        animation: panelFade 260ms ease;
      }

      .tab-panel[hidden] {
        display: none;
      }

      .reveal {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 650ms ease, transform 650ms ease;
      }

      .reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      .delay-1 {
        transition-delay: 110ms;
      }

      .delay-2 {
        transition-delay: 220ms;
      }

      .delay-3 {
        transition-delay: 330ms;
      }

      footer {
        padding: 1.5rem 0 0;
        text-align: center;
        color: var(--muted);
      }

      @keyframes float {
        0%,
        100% {
          transform: translate3d(0, 0, 0) scale(1);
        }
        50% {
          transform: translate3d(0, 1.6rem, 0) scale(1.04);
        }
      }

      @keyframes panelFade {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (max-width: 880px) {
        .topbar {
          align-items: stretch;
          flex-direction: column;
          border-radius: 30px;
        }

        .hero {
          grid-template-columns: 1fr;
        }

        .quote {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 720px) {
        .page {
          width: min(100% - 1rem, 100%);
        }

        .hero,
        section {
          padding: 1rem;
        }

        .hero__content,
        .hero__panel {
          padding: 1.2rem;
        }

        .panel-grid {
          grid-template-columns: 1fr;
        }

        .tab-shell {
          padding: 1rem;
        }

        .shell,
        .card,
        .feature,
        .contact,
        .timeline__item,
        .quote,
        .spotlight {
          border-radius: 22px;
        }

        h1 {
          font-size: clamp(2.8rem, 18vw, 4rem);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation: none !important;
          transition: none !important;
        }

        .reveal {
          opacity: 1;
          transform: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <div class="topbar">
        <a class="brand" href={import.meta.env.BASE_URL}>
          <span class="brand__mark">AS</span>
          <span>Ana Sampaio Bahia</span>
        </a>
        <div class="topbar__actions">
          <a class="button button--secondary" href={articlesUrl} data-tab-link="artigos">Artigos</a>
          <button class="theme-toggle" type="button" data-theme-toggle>
            <span aria-hidden="true">🌙</span>
            <span data-theme-label>Modo escuro</span>
          </button>
        </div>
      </div>

      <header class="shell hero">
        <div class="hero__content reveal is-visible">
          <span class="eyebrow">Psicologia clínica com presença digital mais acolhedora</span>
          <div class="hero__copy">
            <div>
              <h1>Ana Sampaio Bahia</h1>
              <p class="lead">
                Uma landing page com atmosfera mais sofisticada, foco no bem-estar e espaço para
                apresentar percurso, áreas de atuação, projetos e publicações com mais personalidade.
              </p>
            </div>
            <div class="chips">
              <span class="chip">Acompanhamento personalizado</span>
              <span class="chip">Sessões presenciais e online</span>
              <span class="chip">Conteúdo editorial</span>
            </div>
            <div class="actions">
              {hasGoogleForm ? (
                <a class="button button--primary" href={googleFormsUrl} target="_blank" rel="noopener noreferrer">
                  Entrar em contacto
                </a>
              ) : (
                <a class="button button--primary" href={contactUrl} data-tab-link="contacto">
                  Como entrar em contacto
                </a>
              )}
              <a class="button button--secondary" href={articlesUrl} data-tab-link="artigos">Explorar artigos</a>
            </div>
          </div>
        </div>

        <aside class="hero__panel reveal is-visible delay-1" aria-label="Destaques">
          <div class="spotlight">
            <h2>Espaço pensado para transmitir calma e confiança</h2>
            <p>
              Visual renovado com profundidade, microanimações e contraste adaptável para leitura
              confortável em qualquer ambiente.
            </p>
          </div>
          <div class="panel-grid">
            <div class="stat">
              <strong>Light + Dark</strong>
              <span>Alternância manual com preferência guardada no navegador.</span>
            </div>
            <div class="stat">
              <strong>Motion</strong>
              <span>Animações subtis, respeitando preferências de movimento reduzido.</span>
            </div>
          </div>
        </aside>
      </header>

      <main>
        <section class="shell tab-shell reveal" aria-labelledby="conteudo">
          <div class="tab-shell__header">
            <div class="section-heading">
              <h2 id="conteudo">Conteúdo organizado por separadores</h2>
              <p>
                Em vez de apresentar tudo numa única sequência, cada área tem agora o seu próprio
                separador para tornar a navegação mais leve e focada.
              </p>
            </div>
            <div class="tablist" role="tablist" aria-label="Secções principais" aria-orientation="horizontal">
              <button class="tab" id="tab-sobre" type="button" role="tab" aria-selected="true" aria-controls="panel-sobre" tabindex="0" data-tab="sobre">
                Sobre
              </button>
              <button class="tab" id="tab-formacao" type="button" role="tab" aria-selected="false" aria-controls="panel-formacao" tabindex="-1" data-tab="formacao">
                Formação
              </button>
              <button class="tab" id="tab-locais" type="button" role="tab" aria-selected="false" aria-controls="panel-locais" tabindex="-1" data-tab="locais">
                Locais
              </button>
              <button class="tab" id="tab-projetos" type="button" role="tab" aria-selected="false" aria-controls="panel-projetos" tabindex="-1" data-tab="projetos">
                Projetos
              </button>
              <button class="tab" id="tab-artigos" type="button" role="tab" aria-selected="false" aria-controls="panel-artigos" tabindex="-1" data-tab="artigos">
                Artigos
              </button>
              <button class="tab" id="tab-contacto" type="button" role="tab" aria-selected="false" aria-controls="panel-contacto" tabindex="-1" data-tab="contacto">
                Contacto
              </button>
            </div>
          </div>

          <div class="tab-panels">
            <section class="tab-panel" id="panel-sobre" role="tabpanel" aria-labelledby="tab-sobre" data-panel="sobre">
              <div class="section-heading">
                <h3>Sobre a Ana</h3>
                <p>
                  Esta apresentação pode evoluir facilmente com biografia, metodologia de trabalho,
                  áreas de intervenção e público acompanhado, mantendo um tom acolhedor e contemporâneo.
                </p>
              </div>
              <div class="features">
                <article class="feature reveal delay-1">
                  <div class="feature__icon" aria-hidden="true">✨</div>
                  <h3>Primeira impressão mais forte</h3>
                  <p>Camadas visuais, gradientes suaves e cartões com profundidade tornam a página mais memorável.</p>
                </article>
                <article class="feature reveal delay-2">
                  <div class="feature__icon" aria-hidden="true">🌗</div>
                  <h3>Conforto em qualquer contexto</h3>
                  <p>O modo claro e escuro adapta a experiência ao utilizador sem depender de bibliotecas externas.</p>
                </article>
                <article class="feature reveal delay-3">
                  <div class="feature__icon" aria-hidden="true">💬</div>
                  <h3>Leitura mais envolvente</h3>
                  <p>Melhor hierarquia visual para destacar informação profissional, artigos e próximos passos.</p>
                </article>
              </div>
            </section>

            <section class="tab-panel" id="panel-formacao" role="tabpanel" aria-labelledby="tab-formacao" data-panel="formacao" hidden>
              <div class="section-heading">
                <h3>Formação</h3>
                <p>Secção preparada para evidenciar percurso académico, especializações e atualização contínua.</p>
              </div>
              <div class="card">
                <ul class="stack">
                  <li>Licenciatura e/ou mestrado em Psicologia — detalhe a adicionar</li>
                  <li>Especializações clínicas ou formação complementar — detalhe a adicionar</li>
                  <li>Cursos, certificações e supervisão contínua — detalhe a adicionar</li>
                </ul>
              </div>
            </section>

            <section class="tab-panel" id="panel-locais" role="tabpanel" aria-labelledby="tab-locais" data-panel="locais" hidden>
              <div class="section-heading">
                <h3>Locais de trabalho</h3>
                <p>
                  Estrutura visual pronta para apresentar consultório, clínica, atendimento online e horários
                  de forma clara e elegante.
                </p>
              </div>
              <div class="grid">
                <article class="card">
                  <h3>Consultório privado — informação a adicionar</h3>
                  <p>Atualize este cartão com morada, modalidade de atendimento ou horários.</p>
                </article>
                <article class="card">
                  <h3>Clínica ou instituição — informação a adicionar</h3>
                  <p>Atualize este cartão com morada, modalidade de atendimento ou horários.</p>
                </article>
                <article class="card">
                  <h3>Atendimento online — informação a adicionar</h3>
                  <p>Atualize este cartão com morada, modalidade de atendimento ou horários.</p>
                </article>
              </div>
            </section>

            <section class="tab-panel" id="panel-projetos" role="tabpanel" aria-labelledby="tab-projetos" data-panel="projetos" hidden>
              <div class="section-heading">
                <h3>Projetos e envolvimento</h3>
                <p>
                  Espaço preparado para destacar colaboração com instituições, iniciativas profissionais,
                  investigação e projetos comunitários.
                </p>
              </div>
              <div class="timeline">
                <article class="timeline__item">
                  <h3>Projeto em destaque</h3>
                  <p>Apresente uma iniciativa central com foco no impacto, na missão e no papel desempenhado.</p>
                </article>
                <article class="timeline__item">
                  <h3>Projeto comunitário ou de investigação</h3>
                  <p>Mostre colaborações, voluntariado ou trabalho académico com o contexto certo.</p>
                </article>
                <article class="timeline__item">
                  <h3>Intervenções e workshops</h3>
                  <p>Inclua eventos, palestras e ações de sensibilização para enriquecer o percurso profissional.</p>
                </article>
              </div>
            </section>

            <section class="tab-panel" id="panel-artigos" role="tabpanel" aria-labelledby="tab-artigos" data-panel="artigos" hidden>
              <div class="section-heading">
                <h3>Artigos e publicações</h3>
                <p>
                  Área reservada para reunir artigos escritos para revista, entrevistas, reflexões clínicas e
                  outros conteúdos editoriais.
                </p>
              </div>
              <div class="grid">
                <article class="card">
                  <h3>Artigo para revista — título a adicionar</h3>
                  <p><strong>Nome da revista</strong></p>
                  <p>Use esta área para uma breve descrição do tema abordado e, se quiser, inclua depois o link.</p>
                </article>
                <article class="card">
                  <h3>Outro artigo em destaque</h3>
                  <p><strong>Nome da revista</strong></p>
                  <p>Pode listar artigos recentes, crónicas, entrevistas ou outras publicações relevantes.</p>
                </article>
              </div>
            </section>

            <section class="tab-panel" id="panel-contacto" role="tabpanel" aria-labelledby="tab-contacto" data-panel="contacto" hidden>
              <div class="contact">
                <div class="section-heading">
                  <h3>Contacto</h3>
                  <p>O formulário pode ficar alojado no Google Forms. Basta substituir o valor de <strong>googleFormsUrl</strong> pelo URL definitivo quando estiver disponível.</p>
                </div>
                <div class="contact__meta">
                  <div class="chips">
                    <span class="chip">Resposta simples e direta</span>
                    <span class="chip">Preparado para futuras atualizações</span>
                  </div>
                  <div class="actions">
                    {hasGoogleForm ? (
                      <a class="button button--primary" href={googleFormsUrl} target="_blank" rel="noopener noreferrer">
                        Abrir formulário de contacto
                      </a>
                    ) : (
                      <span class="button button--disabled">Formulário disponível em breve</span>
                    )}
                  </div>
                  <p>
                    Quando o link final estiver pronto, esta área pode também incluir email profissional,
                    redes sociais ou localização de consultório.
                  </p>
                </div>
              </div>
            </section>
          </div>
        </section>

        <section class="shell reveal" aria-labelledby="citacao">
          <div class="quote reveal delay-1">
            <div>
              <div class="section-heading">
                <h2 id="citacao">Tom mais humano e editorial</h2>
                <p>
                  O novo visual cria uma presença online mais expressiva sem perder sobriedade,
                  acessibilidade e facilidade de manutenção.
                </p>
              </div>
            </div>
            <strong>Design com movimento, clareza e contraste.</strong>
          </div>
        </section>
      </main>

      <footer>
        <p>© {new Date().getFullYear()} Ana Sampaio Bahia — Psicóloga.</p>
      </footer>
    </div>

    <script is:inline>
      const root = document.documentElement;
      const themeToggle = document.querySelector('[data-theme-toggle]');
      const themeLabel = document.querySelector('[data-theme-label]');
      const themeIcons = { light: '🌙', dark: '☀️' };
      const themeText = {
        light: 'Modo escuro',
        dark: 'Modo claro',
      };

      const setTheme = (theme) => {
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
        localStorage.setItem('theme-preference', theme);

        if (themeToggle && themeLabel) {
          themeToggle.setAttribute('aria-label', themeText[theme]);
          themeLabel.textContent = themeText[theme];
          const icon = themeToggle.querySelector('[aria-hidden="true"]');
          if (icon) icon.textContent = themeIcons[theme];
        }
      };

      const initialTheme = root.dataset.theme === 'dark' ? 'dark' : 'light';
      setTheme(initialTheme);

      themeToggle?.addEventListener('click', () => {
        setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      const tabShell = document.querySelector('.tab-shell');
      const tabs = Array.from(tabShell?.querySelectorAll('[role="tab"]') || []);
      const tablist = tabShell?.querySelector('[role="tablist"]');
      const panels = Array.from(tabShell?.querySelectorAll('[role="tabpanel"]') || []);
      const tabLinks = document.querySelectorAll('[data-tab-link]');
      const motionDisabled = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const supportsIntersectionObserver = 'IntersectionObserver' in window;
      const tabOrientation = tablist?.getAttribute('aria-orientation') || 'horizontal';
      const revealItems = Array.from(document.querySelectorAll('.reveal'));
      const revealObserver = !motionDisabled && supportsIntersectionObserver
        ? new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.18 }
          )
        : null;

      const updateReveals = () => {
        if (motionDisabled || !supportsIntersectionObserver) {
          revealItems.forEach((item) => item.classList.add('is-visible'));
          return;
        }

        revealItems.forEach((item) => {
          if (item.closest('[role="tabpanel"][hidden]')) return;
          if (item.classList.contains('is-visible')) return;
          revealObserver?.observe(item);
        });
      };

      const normalizeTabId = (value) =>
        value.replace(/^#/, '').replace(/^tab-/, '').replace(/^panel-/, '');

      const buildHistoryState = (tabId) => {
        const currentState = history.state && typeof history.state === 'object' ? history.state : {};
        return { ...currentState, activeTab: tabId };
      };

      const activateTab = (tabId, options = {}) => {
        const { focus = false, hashMode = 'push', scrollTabIntoView = false } = options;
        const activeTabButton = tabs.find((tab) => tab.dataset.tab === tabId);

        tabs.forEach((tab) => {
          const isActive = tab.dataset.tab === tabId;
          tab.setAttribute('aria-selected', String(isActive));
          tab.tabIndex = isActive ? 0 : -1;
          if (isActive && focus) tab.focus();
        });

        panels.forEach((panel) => {
          const isActive = panel.dataset.panel === tabId;
          panel.hidden = !isActive;
        });

        if (activeTabButton && scrollTabIntoView) {
          activeTabButton.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        }

        if (hashMode !== 'none') {
          const nextUrl = new URL(window.location.href);
          nextUrl.hash = tabId;
          const nextState = buildHistoryState(tabId);
          if (window.location.hash === `#${tabId}`) {
            if (history.state?.activeTab !== tabId) {
              history.replaceState(nextState, '', nextUrl);
            }
          } else if (hashMode === 'replace') {
            history.replaceState(nextState, '', nextUrl);
          } else {
            history.pushState(nextState, '', nextUrl);
          }
        }

        updateReveals();
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          if (tab.getAttribute('aria-selected') === 'true') return;
          activateTab(tab.dataset.tab, { hashMode: 'push' });
        });
        tab.addEventListener('keydown', (event) => {
          const nextIndexMap = {
            Home: 0,
            End: tabs.length - 1,
          };

          if (tabOrientation === 'vertical') {
            nextIndexMap.ArrowDown = (index + 1) % tabs.length;
            nextIndexMap.ArrowUp = (index - 1 + tabs.length) % tabs.length;
          } else {
            nextIndexMap.ArrowRight = (index + 1) % tabs.length;
            nextIndexMap.ArrowLeft = (index - 1 + tabs.length) % tabs.length;
          }

          const nextIndex = nextIndexMap[event.key];
          if (nextIndex === undefined) return;

          event.preventDefault();
          activateTab(tabs[nextIndex].dataset.tab, { focus: true, hashMode: 'replace', scrollTabIntoView: true });
        });
      });

      tabLinks.forEach((link) => {
        link.addEventListener('click', (event) => {
          const targetTab = link.getAttribute('data-tab-link');
          if (!targetTab) return;
          const href = link.getAttribute('href');
          if (!href) return;
          const targetUrl = new URL(href, window.location.href);
          const currentUrl = new URL(window.location.href);
          const targetPage = `${targetUrl.origin}${targetUrl.pathname}${targetUrl.search}`;
          const currentPage = `${currentUrl.origin}${currentUrl.pathname}${currentUrl.search}`;
          const isSamePageHashLink =
            targetPage === currentPage &&
            targetUrl.hash === `#${targetTab}`;

          if (!isSamePageHashLink) return;
          if (tabs.find((tab) => tab.dataset.tab === targetTab)?.getAttribute('aria-selected') === 'true') return;
          event.preventDefault();
          activateTab(targetTab, { hashMode: 'push' });
          document.querySelector('.tab-shell')?.scrollIntoView({ behavior: motionDisabled ? 'auto' : 'smooth', block: 'start' });
        });
      });

      const hashTab = normalizeTabId(window.location.hash);
      const defaultTab = tabs.some((tab) => tab.dataset.tab === hashTab) ? hashTab : 'sobre';
      activateTab(defaultTab, { hashMode: 'none' });
      if (history.state?.activeTab !== defaultTab) {
        history.replaceState(buildHistoryState(defaultTab), '', window.location.href);
      }

      const syncTabWithUrl = () => {
        const nextHashTab = normalizeTabId(window.location.hash);
        if (tabs.some((tab) => tab.dataset.tab === nextHashTab)) {
          activateTab(nextHashTab, { hashMode: 'none' });
        } else {
          activateTab('sobre', { hashMode: 'none' });
        }
      };

      window.addEventListener('hashchange', () => {
        const nextHashTab = normalizeTabId(window.location.hash);
        if (history.state?.activeTab === nextHashTab) return;
        syncTabWithUrl();
      });
      window.addEventListener('popstate', (event) => {
        const stateTab = normalizeTabId(event.state?.activeTab || window.location.hash);
        if (tabs.some((tab) => tab.dataset.tab === stateTab)) {
          activateTab(stateTab, { hashMode: 'none' });
        } else {
          activateTab('sobre', { hashMode: 'none' });
        }
      });

      updateReveals();
    </script>
  </body>
</html>

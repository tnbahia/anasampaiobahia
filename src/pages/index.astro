---
import {
  perfil,
  destaques,
  areas,
  abordagem,
  locais,
  percurso,
  formacaoAcademica,
  formacaoComplementar,
  outrasFormacoes,
  projetos,
  escrita,
  voluntariado,
} from '../data/ana';

const base = import.meta.env.BASE_URL;
const anosDeExperiencia = new Date().getFullYear() - perfil.inicioDaCarreira;
const temFormulario = Boolean(perfil.formularioContactoUrl);
const iniciais = perfil.iniciais;

// O email vai codificado em entidades HTML para dificultar a recolha automática por robôs de spam.
const codificar = (texto: string) => [...texto].map((c) => `&#${c.codePointAt(0)};`).join('');
const linkEmail = `<a href="${codificar(`mailto:${perfil.email}`)}">${codificar(perfil.email)}</a>`;

const foto = (caminho: string) => `${base}${caminho}`;

const navegacao = [
  { id: 'areas', texto: 'Áreas de consulta' },
  { id: 'onde', texto: 'Onde' },
  { id: 'percurso', texto: 'Percurso' },
  { id: 'formacao', texto: 'Formação' },
  { id: 'projetos', texto: 'Projetos' },
];
---

<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{perfil.nome} · {perfil.profissao} no Porto, em Santo Tirso e online</title>
    <meta
      name="description"
      content={`${perfil.nome}, psicóloga (cédula profissional n.º ${perfil.cedulaOPP}). Consulta de adultos e adolescentes, terapia familiar e de casal e aconselhamento parental no Porto, em Santo Tirso e online.`}
    />
    <meta property="og:title" content={`${perfil.nome} · ${perfil.profissao}`} />
    <meta
      property="og:description"
      content="Consulta de adultos e adolescentes, terapia familiar e de casal e aconselhamento parental no Porto, em Santo Tirso e online."
    />
    <meta property="og:locale" content="pt_PT" />
    <script is:inline>
      (() => {
        let savedTheme = null;
        try {
          savedTheme = localStorage.getItem('theme-preference');
        } catch {}
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const theme = savedTheme || systemTheme;
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <style is:global>
      /* Paleta em tons terra: areia, terracota, castanho e verde-salva. */
      :root {
        color-scheme: light dark;
        --background: #f4eee4;
        --background-rgb: 244, 238, 228;
        --surface: rgba(255, 251, 245, 0.82);
        --surface-strong: rgba(255, 251, 245, 0.94);
        --surface-alt: rgba(236, 223, 204, 0.9);
        --text: #3a2e25;
        --muted: #6c5d4f;
        --accent: #b0613f;
        --accent-strong: #8e4a2e;
        --accent-rgb: 176, 97, 63;
        --accent-soft: rgba(176, 97, 63, 0.12);
        --secondary: #7a8566;
        --secondary-rgb: 122, 133, 102;
        --secondary-soft: rgba(122, 133, 102, 0.18);
        --glow-rgb: 222, 184, 140;
        --brand-gradient: linear-gradient(160deg, rgba(166, 92, 58, 0.96), rgba(112, 124, 92, 0.96));
        --on-accent: #fff;
        --border: rgba(110, 84, 60, 0.16);
        --shadow: 0 24px 80px rgba(60, 40, 24, 0.14);
        --shadow-soft: 0 12px 32px rgba(60, 40, 24, 0.08);
      }

      :root[data-theme='dark'] {
        --background: #1b1612;
        --background-rgb: 27, 22, 18;
        --surface: rgba(40, 32, 26, 0.74);
        --surface-strong: rgba(44, 35, 28, 0.92);
        --surface-alt: rgba(60, 48, 38, 0.8);
        --text: #f2e8dc;
        --muted: #c9b9a6;
        --accent: #e09a72;
        --accent-strong: #ecb08e;
        --accent-rgb: 224, 154, 114;
        --accent-soft: rgba(224, 154, 114, 0.14);
        --secondary: #b5bf9a;
        --secondary-rgb: 181, 191, 154;
        --secondary-soft: rgba(181, 191, 154, 0.14);
        --glow-rgb: 150, 98, 60;
        --brand-gradient: linear-gradient(160deg, rgba(140, 76, 46, 0.96), rgba(88, 98, 70, 0.96));
        --on-accent: #2a1a10;
        --border: rgba(255, 240, 225, 0.12);
        --shadow: 0 28px 90px rgba(8, 5, 2, 0.45);
        --shadow-soft: 0 12px 36px rgba(8, 5, 2, 0.28);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 6.5rem;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background:
          radial-gradient(circle at top left, rgba(var(--glow-rgb), 0.5), transparent 28%),
          radial-gradient(circle at top right, rgba(var(--secondary-rgb), 0.22), transparent 24%),
          linear-gradient(180deg, rgba(var(--background-rgb), 1) 0%, rgba(var(--background-rgb), 0.98) 30%, rgba(var(--background-rgb), 1) 100%);
        overflow-x: hidden;
      }

      body::before,
      body::after {
        content: '';
        position: fixed;
        width: 24rem;
        height: 24rem;
        border-radius: 50%;
        pointer-events: none;
        filter: blur(18px);
        opacity: 0.45;
        z-index: 0;
        animation: float 16s ease-in-out infinite;
      }

      body::before {
        top: -6rem;
        right: -6rem;
        background: rgba(var(--accent-rgb), 0.16);
      }

      body::after {
        bottom: 10rem;
        left: -8rem;
        background: rgba(var(--secondary-rgb), 0.16);
        animation-delay: -8s;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        font: inherit;
      }

      h1,
      h2,
      h3,
      p,
      ul,
      ol,
      dl,
      dd {
        margin: 0;
      }

      .page {
        position: relative;
        z-index: 1;
        width: min(1160px, calc(100% - 2rem));
        margin: 0 auto;
        padding-bottom: 4rem;
      }

      .shell {
        position: relative;
        overflow: hidden;
        backdrop-filter: blur(20px);
        background: linear-gradient(180deg, var(--surface-strong), var(--surface));
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
      }

      .shell,
      .card,
      .quote,
      .spotlight {
        border-radius: 28px;
      }

      /* Barra de topo */

      .topbar {
        position: sticky;
        top: 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 0.75rem 0.75rem 1.25rem;
        margin: 1rem 0 1.5rem;
        background: rgba(var(--background-rgb), 0.72);
        border: 1px solid var(--border);
        backdrop-filter: blur(18px);
        box-shadow: var(--shadow-soft);
        border-radius: 999px;
        z-index: 5;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        font-weight: 700;
        white-space: nowrap;
      }

      .brand__mark {
        display: grid;
        place-items: center;
        width: 2.6rem;
        height: 2.6rem;
        border-radius: 0.95rem;
        background: var(--brand-gradient);
        color: #fff;
        box-shadow: 0 12px 26px rgba(var(--accent-rgb), 0.24);
      }

      .nav {
        display: flex;
        gap: 0.25rem;
        margin-left: auto;
        overflow-x: auto;
        scrollbar-width: none;
      }

      .nav a {
        padding: 0.6rem 0.85rem;
        border-radius: 999px;
        color: var(--muted);
        font-size: 0.95rem;
        white-space: nowrap;
        transition: background-color 180ms ease, color 180ms ease;
      }

      .nav a:hover {
        background: var(--accent-soft);
        color: var(--text);
      }

      .topbar__actions,
      .actions,
      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
      }

      .topbar__actions {
        flex-wrap: nowrap;
        gap: 0.5rem;
      }

      .theme-toggle,
      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        padding: 0.95rem 1.35rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.16);
        color: var(--text);
        white-space: nowrap;
        transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
      }

      .topbar .button,
      .topbar .theme-toggle {
        padding: 0.7rem 1.1rem;
      }

      .theme-toggle {
        cursor: pointer;
      }

      .button--primary {
        color: var(--on-accent);
        background: linear-gradient(135deg, var(--accent), var(--accent-strong));
        border-color: transparent;
        box-shadow: 0 14px 30px rgba(var(--accent-rgb), 0.28);
      }


      .button--secondary {
        background: var(--surface);
      }

      .button--disabled {
        opacity: 0.75;
        cursor: not-allowed;
        background: var(--surface-alt);
      }

      .button:hover,
      .theme-toggle:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-soft);
      }

      .button:focus-visible,
      .theme-toggle:focus-visible,
      .nav a:focus-visible,
      a:focus-visible {
        outline: 3px solid var(--accent-strong);
        outline-offset: 3px;
      }

      /* Apresentação */

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
        gap: 1.5rem;
        padding: 1.5rem;
      }

      .hero__content,
      .hero__panel {
        padding: clamp(1.6rem, 3vw, 2.6rem);
      }

      .hero__copy {
        display: grid;
        gap: 1.5rem;
      }

      .eyebrow,
      .chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        width: fit-content;
        border-radius: 999px;
        font-size: 0.95rem;
      }

      .eyebrow {
        padding: 0.55rem 0.95rem;
        margin-bottom: 1.35rem;
        background: var(--accent-soft);
        color: var(--accent-strong);
        font-weight: 700;
      }

      h1 {
        max-width: 10ch;
        font-size: clamp(3.1rem, 8vw, 5.5rem);
        line-height: 0.92;
        letter-spacing: -0.05em;
        margin-bottom: 1rem;
      }

      .lead {
        max-width: 58ch;
        color: var(--muted);
        font-size: 1.12rem;
        line-height: 1.75;
      }

      .facts {
        display: grid;
        gap: 0.6rem;
        padding: 0;
        list-style: none;
      }

      .facts li {
        display: flex;
        gap: 0.7rem;
        align-items: center;
        color: var(--text);
      }

      .hero__panel {
        display: grid;
        gap: 1rem;
        align-content: start;
      }

      .photo {
        position: relative;
        display: grid;
        place-items: center;
        width: 100%;
        aspect-ratio: 4 / 5;
        overflow: hidden;
        border-radius: 28px;
        background:
          radial-gradient(circle at top right, rgba(255, 255, 255, 0.2), transparent 28%),
          var(--brand-gradient);
        box-shadow: 0 22px 40px rgba(var(--secondary-rgb), 0.2);
      }

      .photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .photo__initials {
        color: rgba(255, 255, 255, 0.92);
        font-size: clamp(4rem, 10vw, 6rem);
        font-weight: 700;
        letter-spacing: -0.05em;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
      }

      .stat {
        padding: 1.15rem;
        background: var(--surface-alt);
        border: 1px solid var(--border);
        border-radius: 22px;
      }

      .stat dt {
        display: block;
        margin-bottom: 0.25rem;
        font-size: 1.6rem;
        font-weight: 700;
      }

      .stat dd {
        color: var(--muted);
        line-height: 1.5;
        font-size: 0.95rem;
      }

      /* Secções */

      main {
        display: grid;
        gap: 1.5rem;
        margin-top: 1.5rem;
      }

      .section {
        padding: clamp(1.25rem, 3vw, 2.25rem);
      }

      .section-heading {
        display: grid;
        gap: 0.7rem;
        margin-bottom: 1.5rem;
      }

      .section-heading h2 {
        font-size: clamp(1.7rem, 4vw, 2.4rem);
        letter-spacing: -0.04em;
      }

      .section-heading p,
      .card p,
      .prose p,
      .entry p,
      .quote p {
        color: var(--muted);
        line-height: 1.75;
      }

      .subheading {
        margin: 2rem 0 1rem;
        font-size: 1.2rem;
      }

      .grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      }

      .card {
        position: relative;
        overflow: hidden;
        padding: 1.5rem;
        background: var(--surface);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-soft);
        transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
      }

      .card:hover {
        transform: translateY(-4px);
      }

      .card h3 {
        margin-bottom: 0.6rem;
        font-size: 1.1rem;
        line-height: 1.35;
      }

      .card__icon {
        display: grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        margin-bottom: 1rem;
        border-radius: 1rem;
        background: linear-gradient(135deg, var(--accent-soft), var(--secondary-soft));
        font-size: 1.3rem;
      }

      .card__eyebrow {
        display: block;
        margin-bottom: 0.5rem;
        color: var(--accent-strong);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .card__link {
        display: inline-flex;
        margin-top: 0.9rem;
        color: var(--accent-strong);
        font-weight: 700;
      }

      .card__link:hover {
        text-decoration: underline;
      }

      .chip {
        padding: 0.45rem 0.8rem;
        background: var(--surface-alt);
        color: var(--accent-strong);
        font-weight: 600;
      }

      /* Abordagem */

      .approach {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
        gap: 1.5rem;
        align-items: center;
      }

      .prose {
        display: grid;
        gap: 1rem;
      }

      .quote {
        display: grid;
        gap: 0.9rem;
        padding: 1.75rem;
        color: #fff;
        background:
          radial-gradient(circle at top right, rgba(255, 255, 255, 0.2), transparent 28%),
          var(--brand-gradient);
        box-shadow: 0 22px 40px rgba(var(--secondary-rgb), 0.2);
      }

      .quote blockquote {
        margin: 0;
        font-size: clamp(1.35rem, 3vw, 1.75rem);
        font-weight: 700;
        line-height: 1.35;
        letter-spacing: -0.02em;
      }

      .quote p {
        color: rgba(255, 255, 255, 0.85);
      }

      .photo--secondary {
        aspect-ratio: 1;
        max-width: 14rem;
        border-radius: 50%;
      }

      /* Linha do tempo */

      .timeline {
        display: grid;
        gap: 0;
        padding: 0;
        list-style: none;
      }

      .entry {
        position: relative;
        display: grid;
        grid-template-columns: 9.5rem minmax(0, 1fr);
        gap: 1.25rem;
        padding: 1.1rem 0;
        border-top: 1px solid var(--border);
      }

      .entry:first-child {
        border-top: none;
      }

      .entry__period {
        color: var(--accent-strong);
        font-weight: 700;
        font-size: 0.95rem;
        padding-top: 0.15rem;
      }

      .entry h3 {
        margin-bottom: 0.35rem;
        font-size: 1.05rem;
        line-height: 1.4;
      }

      .entry__place {
        color: var(--text);
        font-weight: 500;
      }

      .note {
        margin-top: 1.25rem;
        color: var(--muted);
        line-height: 1.75;
      }

      /* Contacto */

      .contact {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
        gap: 1.5rem;
        align-items: start;
      }

      .contact__box {
        display: grid;
        gap: 1rem;
        padding: 1.5rem;
        border-radius: 22px;
        background: var(--surface-alt);
        border: 1px solid var(--border);
      }

      .contact__box--pending {
        border-style: dashed;
      }

      .contact__email a {
        color: var(--accent-strong);
        font-weight: 700;
        word-break: break-all;
      }

      .contact__list {
        display: grid;
        gap: 0.5rem;
        padding: 0;
        list-style: none;
        color: var(--muted);
        line-height: 1.6;
      }

      .small {
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.6;
      }

      .reveal {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 650ms ease, transform 650ms ease;
      }

      .reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      footer {
        display: grid;
        gap: 0.35rem;
        padding: 1.5rem 0 0;
        text-align: center;
        color: var(--muted);
        font-size: 0.95rem;
      }

      @keyframes float {
        0%,
        100% {
          transform: translate3d(0, 0, 0) scale(1);
        }
        50% {
          transform: translate3d(0, 1.6rem, 0) scale(1.04);
        }
      }

      @media (max-width: 1240px) {
        .theme-toggle__label {
          display: none;
        }
      }

      @media (max-width: 1080px) {
        .nav {
          display: none;
        }
      }

      @media (max-width: 880px) {
        .hero,
        .approach,
        .contact {
          grid-template-columns: 1fr;
        }

        .hero__panel {
          grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
          align-items: stretch;
        }

        .stats {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 720px) {
        .page {
          width: min(100% - 1rem, 100%);
        }

        .topbar {
          padding-left: 0.75rem;
        }

        .brand__name,
        .theme-toggle__label {
          display: none;
        }

        .topbar__actions {
          margin-left: auto;
        }

        .hero {
          padding: 1rem;
        }

        .hero__content,
        .hero__panel {
          padding: 1rem;
        }

        .hero__panel {
          grid-template-columns: 1fr;
        }

        .photo {
          aspect-ratio: 1;
          max-width: 18rem;
        }

        .stats {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .entry {
          grid-template-columns: 1fr;
          gap: 0.35rem;
        }

        .shell,
        .card,
        .quote {
          border-radius: 22px;
        }

        h1 {
          font-size: clamp(2.8rem, 15vw, 4rem);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation: none !important;
          transition: none !important;
        }

        .reveal {
          opacity: 1;
          transform: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header class="topbar">
        <a class="brand" href={base} aria-label={`${perfil.nome}, página inicial`}>
          <span class="brand__mark" aria-hidden="true">{iniciais}</span>
          <span class="brand__name">{perfil.nome}</span>
        </a>
        <nav class="nav" aria-label="Secções da página">
          {navegacao.map((item) => <a href={`#${item.id}`}>{item.texto}</a>)}
        </nav>
        <div class="topbar__actions">
          <a class="button button--primary" href="#contacto">Entrar em contacto</a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Mudar para o modo escuro">
            <span aria-hidden="true" data-theme-icon>🌙</span>
            <span class="theme-toggle__label" data-theme-label>Modo escuro</span>
          </button>
        </div>
      </header>

      <section class="shell hero" aria-labelledby="nome">
        <div class="hero__content reveal is-visible">
          <span class="eyebrow">{perfil.profissao} · Cédula profissional n.º {perfil.cedulaOPP}</span>
          <div class="hero__copy">
            <div>
              <h1 id="nome">{perfil.nome}</h1>
              <p class="lead">{perfil.resumo}</p>
            </div>
            <ul class="facts">
              {destaques.map((item) => (
                <li>
                  <span aria-hidden="true">{item.icone}</span>
                  {item.texto}
                </li>
              ))}
            </ul>
            <div class="actions">
              <a class="button button--primary" href="#contacto">Entrar em contacto</a>
              <a class="button button--secondary" href="#areas">Áreas de consulta</a>
            </div>
          </div>
        </div>

        <aside class="hero__panel reveal is-visible" aria-label="Em resumo">
          <div class="photo">
            {perfil.fotos.retrato ? (
              <img src={foto(perfil.fotos.retrato)} alt={`Fotografia de ${perfil.nome}`} width="480" height="600" />
            ) : (
              <span class="photo__initials" aria-hidden="true">{iniciais}</span>
            )}
          </div>
          <dl class="stats">
            <div class="stat">
              <dt>+{anosDeExperiencia}</dt>
              <dd>anos de experiência</dd>
            </div>
            <div class="stat">
              <dt>3</dt>
              <dd>formas de consulta: Porto, Santo Tirso e online</dd>
            </div>
          </dl>
        </aside>
      </section>

      <main>
        <section class="shell section reveal" id="areas" aria-labelledby="areas-titulo">
          <div class="section-heading">
            <h2 id="areas-titulo">Áreas de consulta</h2>
            <p>Consultas para adultos, adolescentes, casais e famílias, presenciais ou online.</p>
          </div>
          <div class="grid">
            {areas.map((area) => (
              <article class="card">
                <div class="card__icon" aria-hidden="true">{area.icone}</div>
                <h3>{area.titulo}</h3>
                <p>{area.texto}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="shell section reveal" id="abordagem" aria-labelledby="abordagem-titulo">
          <div class="approach">
            <div>
              <div class="section-heading">
                <h2 id="abordagem-titulo">Abordagem</h2>
              </div>
              <div class="prose">
                {abordagem.map((paragrafo) => <p>{paragrafo}</p>)}
              </div>
            </div>
            <figure class="quote" style="margin: 0;">
              <blockquote>«{perfil.lema}»</blockquote>
              <figcaption><p>As perguntas que orientam o trabalho da Ana, na consulta e fora dela.</p></figcaption>
            </figure>
          </div>
          {perfil.fotos.secundaria && (
            <div class="photo photo--secondary" style="margin-top: 1.5rem;">
              <img src={foto(perfil.fotos.secundaria)} alt={`Fotografia de ${perfil.nome}`} width="320" height="320" loading="lazy" />
            </div>
          )}
        </section>

        <section class="shell section reveal" id="onde" aria-labelledby="onde-titulo">
          <div class="section-heading">
            <h2 id="onde-titulo">Locais de consulta</h2>
            <p>Presencialmente no Porto e em Santo Tirso, ou online, onde quer que esteja.</p>
          </div>
          <div class="grid">
            {locais.map((local) => (
              <article class="card">
                <span class="card__eyebrow">{local.cidade}</span>
                <h3>{local.nome}</h3>
                <p>{local.morada}</p>
                {local.mapa && (
                  <a class="card__link" href={local.mapa} target="_blank" rel="noopener noreferrer">
                    Ver no mapa ↗
                  </a>
                )}
              </article>
            ))}
          </div>
        </section>

        <section class="shell section reveal" id="percurso" aria-labelledby="percurso-titulo">
          <div class="section-heading">
            <h2 id="percurso-titulo">Percurso profissional</h2>
            <p>
              Mais de {anosDeExperiencia} anos de trabalho com crianças, jovens e famílias, em escolas, instituições de
              acolhimento, associações e consulta privada.
            </p>
          </div>
          <ol class="timeline">
            {percurso.map((item) => (
              <li class="entry">
                <span class="entry__period">{item.periodo}</span>
                <div>
                  <h3 class="entry__place">{item.local}</h3>
                  <p>{item.texto}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section class="shell section reveal" id="formacao" aria-labelledby="formacao-titulo">
          <div class="section-heading">
            <h2 id="formacao-titulo">Formação</h2>
            <p>Inscrita na Ordem dos Psicólogos Portugueses, com a cédula profissional n.º {perfil.cedulaOPP}.</p>
          </div>
          <ol class="timeline">
            {formacaoAcademica.map((item) => (
              <li class="entry">
                <span class="entry__period">{item.periodo}</span>
                <div>
                  <h3>{item.titulo}</h3>
                  <p class="entry__place">{item.instituicao}</p>
                  <p>{item.texto}</p>
                </div>
              </li>
            ))}
          </ol>

          <h3 class="subheading">Formação complementar</h3>
          <ol class="timeline">
            {formacaoComplementar.map((item) => (
              <li class="entry">
                <span class="entry__period">{item.periodo}</span>
                <div>
                  <h3>{item.titulo}</h3>
                  <p>{item.instituicao}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="note">{outrasFormacoes}</p>
        </section>

        <section class="shell section reveal" id="projetos" aria-labelledby="projetos-titulo">
          <div class="section-heading">
            <h2 id="projetos-titulo">Projetos e escrita</h2>
            <p>Projetos que criou e coordena, e textos sobre família e relações.</p>
          </div>

          <div class="grid">
            {projetos.map((projeto) => (
              <article class="card">
                <span class="card__eyebrow">{projeto.periodo}</span>
                <h3>{projeto.titulo}</h3>
                <p>{projeto.texto}</p>
              </article>
            ))}
          </div>

          <h3 class="subheading">Escrita</h3>
          <div class="grid">
            {escrita.colaboracoes.map((item) => (
              <article class="card">
                <span class="card__eyebrow">{item.periodo}</span>
                <h3>{item.titulo}</h3>
                <p>{item.texto}</p>
              </article>
            ))}
          </div>

          <h3 class="subheading">Artigos</h3>
          <div class="grid">
            {escrita.artigos.map((artigo) => (
              <article class="card">
                <span class="card__eyebrow">
                  {artigo.fonte} · <time datetime={artigo.data}>{artigo.dataLegivel}</time>
                </span>
                <h3>{artigo.titulo}</h3>
                <p>{artigo.resumo}</p>
                <a class="card__link" href={artigo.url} target="_blank" rel="noopener noreferrer">
                  Ler o artigo ↗
                </a>
              </article>
            ))}
          </div>

          <h3 class="subheading">Voluntariado</h3>
          <ol class="timeline">
            {voluntariado.map((item) => (
              <li class="entry">
                <span class="entry__period">{item.periodo}</span>
                <div>
                  <h3>{item.titulo}</h3>
                  <p>{item.texto}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section class="shell section reveal" id="contacto" aria-labelledby="contacto-titulo">
          <div class="contact">
            <div>
              <div class="section-heading">
                <h2 id="contacto-titulo">Entrar em contacto</h2>
                <p>
                  Para marcar uma primeira consulta ou esclarecer alguma dúvida, preencha o formulário de contacto ou envie
                  um email. A Ana responde com a maior brevidade possível.
                </p>
              </div>
              <ul class="contact__list">
                {locais.map((local) => (
                  <li>
                    <strong>{local.cidade}</strong> · {local.nome}
                  </li>
                ))}
              </ul>
            </div>

            <div class:list={['contact__box', { 'contact__box--pending': !temFormulario }]}>
              {temFormulario ? (
                <a
                  class="button button--primary"
                  href={perfil.formularioContactoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Abrir o formulário de contacto
                </a>
              ) : (
                <span class="button button--disabled" aria-disabled="true">Formulário de contacto disponível em breve</span>
              )}
              <p class="contact__email">Email: <Fragment set:html={linkEmail} /></p>
              <p class="small">
                Por uma questão de privacidade, não inclua no formulário nem no email informação clínica detalhada. Esses
                assuntos serão tratados em consulta.
              </p>
            </div>
          </div>
        </section>
      </main>

      <footer>
        <p>© {new Date().getFullYear()} {perfil.nome} · {perfil.profissao} · Cédula profissional n.º {perfil.cedulaOPP}</p>
        <p>{perfil.localizacao} · Online</p>
      </footer>
    </div>

    <script is:inline>
      const root = document.documentElement;
      const themeToggle = document.querySelector('[data-theme-toggle]');
      const themeLabel = document.querySelector('[data-theme-label]');
      const themeIcon = document.querySelector('[data-theme-icon]');
      const themeIcons = { light: '🌙', dark: '☀️' };
      const themeText = { light: 'Modo escuro', dark: 'Modo claro' };
      const themeAria = { light: 'Mudar para o modo escuro', dark: 'Mudar para o modo claro' };

      const setTheme = (theme, save) => {
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
        if (save) {
          try {
            localStorage.setItem('theme-preference', theme);
          } catch {}
        }
        themeToggle?.setAttribute('aria-label', themeAria[theme]);
        if (themeLabel) themeLabel.textContent = themeText[theme];
        if (themeIcon) themeIcon.textContent = themeIcons[theme];
      };

      setTheme(root.dataset.theme === 'dark' ? 'dark' : 'light', false);
      themeToggle?.addEventListener('click', () => {
        setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark', true);
      });

      const revealItems = document.querySelectorAll('.reveal:not(.is-visible)');
      const motionDisabled = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (motionDisabled || !('IntersectionObserver' in window)) {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08 }
        );
        revealItems.forEach((item) => observer.observe(item));
      }
    </script>
  </body>
</html>
